# ──────────────────────────────────────────────────────────────────────────
#  Automated Outreach Pipeline — environment configuration
#  Copy this file to ".env" and fill in your real keys.
#      cp .env.example .env      (PowerShell:  Copy-Item .env.example .env)
# ──────────────────────────────────────────────────────────────────────────

# ── Stage 1 · lookalike companies ──
# Pick the source: "apollo" (default) or "ocean". Override with --source too.
STAGE1_PROVIDER=apollo

# Apollo.io  (Settings → API → API Keys; free plan includes API access)
APOLLO_API_KEY=

# Ocean.io  (Settings → API tokens at app.ocean.io) — only needed if STAGE1_PROVIDER=ocean
OCEAN_API_TOKEN=

# ── Stage 2 + 3 · Prospeo ──  (app.prospeo.io/api → API key)
# Stage 2: search-person (decision-makers + LinkedIn URLs)
# Stage 3: enrich-person (LinkedIn/name → verified work email)
PROSPEO_API_KEY=
# Only accept VERIFIED emails (true) vs. allow probable ones (false).
PROSPEO_ONLY_VERIFIED=true

# ── Stage 4 · Brevo ──  (app.brevo.com → SMTP & API → API Keys)
BREVO_API_KEY=
# Must be a sender you have verified inside Brevo, otherwise sends are rejected.
SENDER_EMAIL=
SENDER_NAME=Your Name

# ── Pipeline safety defaults (all overridable via CLI flags) ──
MAX_COMPANIES=10
MAX_CONTACTS_PER_COMPANY=3
MAX_EMAILS=25
# Polite pause (seconds) between outbound API calls to stay under rate limits.
REQUEST_DELAY_SECONDS=0.4

# Seniority levels to target in Prospeo (comma separated).
# Valid values include: Founder/Owner, C-Suite, Vice President, Director, Head
TARGET_SENIORITY=Founder/Owner,C-Suite,Vice President
